<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Poe2StashPricer.App</RootNamespace>
    <!-- The binary, the window class, the desktop entry and the command line all answer to one name. -->
    <AssemblyName>poe2-stash-pricer</AssemblyName>
    <Nullable>enable</Nullable>
    <ApplicationIcon />
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Published as one self-contained file, so nobody has to install .NET, and trimmed and compressed so
      that file stays a sensible size (97 MB down to 23 MB).
      NativeAOT is still out: Tmds.DBus builds its D-Bus proxies with Reflection.Emit at run time.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- The previous X error handler is called through a raw function pointer; see X11Errors. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Tmds.DBus builds its proxies by reflection, so the trimmer cannot see what they need and says so.
      Keeping the whole assembly costs little and removes the guesswork; JSON is handled instead by
      listing its types in JsonContext, which the trimmer can follow.
    -->
    <TrimmerRootAssembly Include="Tmds.DBus" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Tmds.DBus" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poe2StashPricer.Core\Poe2StashPricer.Core.csproj" />
  </ItemGroup>

</Project>
